# Local: copia este archivo a .env y ejecuta npm run dev (se carga solo).
# En el VPS las variables viven en /opt/golddigger/.env (las crea deploy/setup-vps.sh).
PORT=3010
HOST=127.0.0.1
# PostgreSQL. Sin esta variable, en desarrollo se usan datos en memoria (usuario admin@golddigger.local / golddigger-dev).
# DATABASE_URL=postgresql://golddigger:clave@127.0.0.1:5432/golddigger

# Contraseña HTTP opcional, solo aplica sin base de datos.
# GD_AUTH_USER=admin
# GD_AUTH_PASS=cambia-esto
